[configuration]

entry_symbol = "vaudio_godot_native_openal_3d_library_init"
compatibility_minimum = "4.5"
version = "1.12.0"

[libraries]

windows.editor.x86_64 = "res://addons/vaudio-godot-native-openal-3d/bin/windows/libvaudiogodotnativeopenal3d.windows.editor.x86_64.dll"
windows.debug.x86_64 = "res://addons/vaudio-godot-native-openal-3d/bin/windows/libvaudiogodotnativeopenal3d.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/vaudio-godot-native-openal-3d/bin/windows/libvaudiogodotnativeopenal3d.windows.template_release.x86_64.dll"
windows.editor.arm64 = "res://addons/vaudio-godot-native-openal-3d/bin/windows-arm64/libvaudiogodotnativeopenal3d.windows.editor.arm64.dll"
windows.debug.arm64 = "res://addons/vaudio-godot-native-openal-3d/bin/windows-arm64/libvaudiogodotnativeopenal3d.windows.template_debug.arm64.dll"
windows.release.arm64 = "res://addons/vaudio-godot-native-openal-3d/bin/windows-arm64/libvaudiogodotnativeopenal3d.windows.template_release.arm64.dll"
linux.editor.x86_64 = "res://addons/vaudio-godot-native-openal-3d/bin/linux/libvaudiogodotnativeopenal3d.linux.editor.x86_64.so"
linux.debug.x86_64 = "res://addons/vaudio-godot-native-openal-3d/bin/linux/libvaudiogodotnativeopenal3d.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/vaudio-godot-native-openal-3d/bin/linux/libvaudiogodotnativeopenal3d.linux.template_release.x86_64.so"
linux.editor.arm64 = "res://addons/vaudio-godot-native-openal-3d/bin/linux-arm64/libvaudiogodotnativeopenal3d.linux.editor.arm64.so"
linux.debug.arm64 = "res://addons/vaudio-godot-native-openal-3d/bin/linux-arm64/libvaudiogodotnativeopenal3d.linux.template_debug.arm64.so"
linux.release.arm64 = "res://addons/vaudio-godot-native-openal-3d/bin/linux-arm64/libvaudiogodotnativeopenal3d.linux.template_release.arm64.so"
macos.editor = "res://addons/vaudio-godot-native-openal-3d/bin/mac/libvaudiogodotnativeopenal3d.macos.editor.universal.dylib"
macos.debug = "res://addons/vaudio-godot-native-openal-3d/bin/mac/libvaudiogodotnativeopenal3d.macos.template_debug.universal.dylib"
macos.release = "res://addons/vaudio-godot-native-openal-3d/bin/mac/libvaudiogodotnativeopenal3d.macos.template_release.universal.dylib"

[dependencies]

windows.x86_64 = { "res://addons/vaudio-godot-native-openal-3d/bin/windows/vaudionative.dll": "" }
windows.arm64 = { "res://addons/vaudio-godot-native-openal-3d/bin/windows-arm64/vaudionative.dll": "" }
linux.x86_64 = { "res://addons/vaudio-godot-native-openal-3d/bin/linux/libvaudionative.so": "" }
linux.arm64 = { "res://addons/vaudio-godot-native-openal-3d/bin/linux-arm64/libvaudionative.so": "" }
macos = { "res://addons/vaudio-godot-native-openal-3d/bin/mac/libvaudionative.dylib": "" }

[icons]

VACustomMaterial = "res://addons/vaudio-godot-native-openal-3d/icons/VACustomMaterial.svg"
VADefaultMaterial = "res://addons/vaudio-godot-native-openal-3d/icons/VADefaultMaterial.svg"
VAEmitter = "res://addons/vaudio-godot-native-openal-3d/icons/VAEmitter.svg"
VAInputStreamSource = "res://addons/vaudio-godot-native-openal-3d/icons/VAInputStreamSource.svg"
VAListener = "res://addons/vaudio-godot-native-openal-3d/icons/VAListener.svg"
VANetworkedStreamSource = "res://addons/vaudio-godot-native-openal-3d/icons/VANetworkedStreamSource.svg"
VAPlayer = "res://addons/vaudio-godot-native-openal-3d/icons/VAPlayer.svg"
VAPlayer3D = "res://addons/vaudio-godot-native-openal-3d/icons/VAPlayer3D.svg"
VASource = "res://addons/vaudio-godot-native-openal-3d/icons/VASource.svg"
VASourceAmbient = "res://addons/vaudio-godot-native-openal-3d/icons/VASourceAmbient.svg"
VASourceLeech = "res://addons/vaudio-godot-native-openal-3d/icons/VASourceLeech.svg"
VASourceRelative = "res://addons/vaudio-godot-native-openal-3d/icons/VASourceRelative.svg"
VAStreamSource = "res://addons/vaudio-godot-native-openal-3d/icons/VAStreamSource.svg"
VAVisualisation = "res://addons/vaudio-godot-native-openal-3d/icons/VAVisualisation.svg"
VAWorld = "res://addons/vaudio-godot-native-openal-3d/icons/VAWorld.svg"